[Unit]
Description=通用设备服务平台
After=network.target

[Service]
Type=simple
User=devconsole
Group=devconsole
WorkingDirectory=/opt/devconsole
ExecStart=/opt/devconsole/platform serve --config /etc/devconsole/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/devconsole
# 不设置PrivateDevices=true，否则会隐藏实际串口。
# 根据设备节点实际组配置SupplementaryGroups，不假定所有机器都是dialout。

[Install]
WantedBy=multi-user.target
